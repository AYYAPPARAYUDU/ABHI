# ==============================================================================
# LOCAL-FIRST PERSONAL AI COMPUTER AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION
# Phase 6 Stage 6.2-D: Docker & Local Deployment Foundation
# ==============================================================================

# Application Environment & Server Settings
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_secure_random_hex_string_in_local_env

# CORS Settings (Allow Local Frontend & Reverse Proxy Access)
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200", "http://localhost:80", "http://127.0.0.1:80"]

# Ollama Local LLM Engine Settings
# When containerized, use host.docker.internal to access native Windows host GPU Ollama:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# When running standalone on Windows host:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=5m

# Storage & Database File Paths
DATABASE_DIR=./database
DATABASE_SQLITE_URL=sqlite+aiosqlite:///./database/relational/system.db
LANCEDB_DIR=./database/vector
MEDIA_STORAGE_DIR=./database/media

# Logging & Observability Settings
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5

# Frontend Operator Console Port (Nginx Gateway)
FRONTEND_PORT=4200
